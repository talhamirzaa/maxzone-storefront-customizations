{% comment %}
  Section: Featured Categories
  File: sections/featured-categories.liquid
{% endcomment %}

<section class="featured-categories-section" id="FeaturedCategories-{{ section.id }}">
  <div class="featured-categories-wrapper {% if section.settings.full_width == false %}page-width{% endif %}">
    {% if section.settings.heading != blank %}
      <div class="featured-categories-header">
        <h2 class="featured-categories-title">{{ section.settings.heading }}</h2>
        {% if section.settings.subheading != blank %}
          <p class="featured-categories-subtitle">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div
      class="featured-categories-grid"
      data-columns-desktop="{{ section.settings.columns_desktop }}"
      data-columns-tablet="{{ section.settings.columns_tablet }}"
      data-layout="{{ section.settings.mobile_layout }}"
    >
      {% for block in section.blocks %}
        {% assign img = block.settings.image %}
        {% assign url = block.settings.link %}
        {% assign title = block.settings.title %}
        {% assign badge = block.settings.badge_text %}
        {% assign badge_style = block.settings.badge_style %}

        <article
          class="category-card"
          {{ block.shopify_attributes }}
        >
          {% if url != blank %}
            <a href="{{ url }}" class="category-card-link" aria-label="{{ title | escape }}">
          {% endif %}

          <div class="category-media">
            {% if img %}
              {% assign widths = '320, 480, 640, 800, 960, 1200, 1600' %}
              {% assign width_list = widths | split: ', ' %}
              <img
                class="category-image"
                src="{{ img | image_url: width: 800 }}"
                srcset="
                  {% for w in width_list %}
                    {% assign w_int = w | strip %}
                    {{ img | image_url: width: w_int }} {{ w_int }}w{% unless forloop.last %}, {% endunless %}
                  {% endfor %}
                "
                sizes="(max-width: 749px) 90vw, (max-width: 989px) 60vw, {{ 100.0 | divided_by: section.settings.columns_desktop | round }}vw"
                alt="{{ img.alt | escape }}"
                loading="lazy"
                width="{{ img.width }}"
                height="{{ img.height }}"
              >
            {% else %}
              <div class="category-image placeholder">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}

            {% if badge != blank %}
              <span class="category-badge category-badge--{{ badge_style }}">{{ badge }}</span>
            {% endif %}
          </div>

          {% if title != blank %}
            <div class="category-content content-align--{{ section.settings.text_align }}">
              <h3 class="category-title">{{ title }}</h3>
              {% if block.settings.subtitle != blank %}
                <p class="category-subtitle">{{ block.settings.subtitle }}</p>
              {% endif %}
            </div>
          {% endif %}

          {% if url != blank %}
            </a>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>

<style>
/* Base */
.featured-categories-section {
  padding: var(--section-padding, 32px 0);
  background: {{ section.settings.background_color }};
  color: {{ section.settings.text_color }};
}
.featured-categories-wrapper {
  padding: 0 2rem !important;
}

/* Header */
.featured-categories-header {
   display: flex;
  justify-content: center;
  gap: 6px;
  margin-bottom: 16px;
  text-align: {{ section.settings.header_align }};
}
.featured-categories-title {
  margin: 0;
  font-size: clamp(18px, 2.2vw, 28px);
}
.featured-categories-subtitle {
  margin: 0;
  font-size: clamp(14px, 1.6vw, 16px);
  opacity: 0.8;
}

/* Grid container */
.featured-categories-grid {
  display: grid;
  grid-gap: {{ section.settings.gap }}px; /* Safari-friendly */
  gap: {{ section.settings.gap }}px;      /* Modern browsers */
  grid-template-columns: repeat(1, 1fr);
}

/* Fallback spacing for Safari quirks */
.featured-categories-grid > * {
  margin: 0; /* reset */
}

/* Responsive columns */
@media (min-width: 990px) {
  .featured-categories-grid {
    grid-template-columns: repeat(var(--cols-desktop, 4), 1fr);
  }
}
@media (min-width: 750px) and (max-width: 989px) {
  .featured-categories-grid {
    grid-template-columns: repeat(var(--cols-tablet, 3), 1fr);
  }
}

/* Mobile layout options */
@media (max-width: 749px) {
  .featured-categories-grid {
    grid-template-columns: repeat(var(--cols-mbl, 3), 1fr);
  }

  .featured-categories-wrapper {
    padding: 0 0.4rem !important;
  }
}

/* Card */
.category-card {
  position: relative;
  border-radius: {{ section.settings.corner_radius }}px;
  overflow: hidden;
  background: {{ section.settings.card_bg }};
}

/* Link overlay for full-card clickable */
.category-card-link {
  display: grid;
  text-decoration: none;
  color: inherit;
}

/* Media with aspect-ratio */
.category-media {
  position: relative;
  width: 100%;
  background: #f4f4f4;
}
.category-image {
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: {{ section.settings.corner_radius }}px;
  -webkit-mask-image: -webkit-radial-gradient(white, black); /* Safari fix */
  transition: transform 350ms ease, filter 350ms ease;
  will-change: transform;
}
.category-image.placeholder {
  display: grid;
  place-items: center;
  height: 100%;
}

/* Hover effects */
.category-card:hover .category-image {
  transform: scale({{ section.settings.hover_zoom }});
  filter: saturate({{ section.settings.hover_saturate }});
}

/* Badge */
.category-badge {
  position: absolute;
  top: 10px;
  left: 10px;
  font-size: 12px;
  padding: 6px 10px;
  border-radius: 20px;
  background: #111;
  color: #fff;
}
.category-badge--light {
  background: #fff;
  color: #111;
  box-shadow: 0 1px 6px rgba(0,0,0,0.1);
}
.category-badge--brand {
  background: {{ section.settings.badge_bg }};
  color: {{ section.settings.badge_text }};
}

/* Content overlay or below */
.category-content {
  display: grid;
  gap: 4px;
  padding: {{ section.settings.content_padding }}px;
  background: {{ section.settings.content_bg }};
}
.content-align--center { text-align: center; }
.content-align--left { text-align: left; }
.content-align--right { text-align: right; }

.category-title {
  margin: 0;
  font-size: clamp(14px, 1.8vw, 18px);
  font-weight: 600;
}
.category-subtitle {
  margin: 0;
  font-size: 13px;
  opacity: 0.75;
}

/* Optional overlay style */
{% if section.settings.overlay_style != 'none' %}
.category-content {
  position: absolute;
  inset: auto 0 0 0;
  color: {{ section.settings.overlay_text }};
  background:
    {% if section.settings.overlay_style == 'gradient' %}
      linear-gradient(to top, {{ section.settings.overlay_bg }}, rgba(0,0,0,0) 60%)
    {% else %}
      {{ section.settings.overlay_bg }}
    {% endif %};
}
{% endif %}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const grids = document.querySelectorAll('#FeaturedCategories-{{ section.id }} .featured-categories-grid');
  grids.forEach(grid => {
    // Apply CSS vars based on settings for responsive columns
    const colsDesktop = grid.getAttribute('data-columns-desktop') || 4;
    const colsTablet = grid.getAttribute('data-columns-tablet') || 3;
    const def_layout = grid.getAttribute('data-layout') || 2;
    grid.style.setProperty('--cols-desktop', colsDesktop);
    grid.style.setProperty('--cols-tablet', colsTablet);
    grid.style.setProperty('--cols-mbl', def_layout);

    // Keyboard accessibility for horizontally scrollable layout
    if (grid.dataset.layout === 'scroll') {
      grid.addEventListener('keydown', (e) => {
        const key = e.key;
        if (key === 'ArrowRight') grid.scrollBy({ left: 300, behavior: 'smooth' });
        if (key === 'ArrowLeft') grid.scrollBy({ left: -300, behavior: 'smooth' });
      });
    }
  });
});
</script>

{% schema %}
{
  "name": "Featured categories",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured Categories" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "test" },
    { "type": "checkbox", "id": "full_width", "label": "Full width", "default": true },
    {
      "type": "select",
      "id": "header_align",
      "label": "Header alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    { "type": "range", "id": "columns_desktop", "label": "Desktop columns", "min": 2, "max": 6, "step": 1, "default": 4 },
    { "type": "range", "id": "columns_tablet", "label": "Tablet columns", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "range", "id": "mobile_layout", "label": "Mobile columns", "min": 1, "max": 3, "step": 1, "default": 2 },
    { "type": "range", "id": "gap", "label": "Item gap (px)", "min": 0, "max": 20, "step": 1, "default": 10 },
    { "type": "range", "id": "corner_radius", "label": "Card corner radius (px)", "min": 0, "max": 24, "step": 2, "default": 10 },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Image aspect ratio",
      "options": [
        { "value": "adapt", "label": "t:sections.collection-list.settings.image_ratio.options__1.label" },
        { "value": "portrait", "label": "t:sections.collection-list.settings.image_ratio.options__2.label" },
        { "value": "square", "label": "t:sections.collection-list.settings.image_ratio.options__3.label" }
      ],
      "default": "adapt"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Card text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    { "type": "color", "id": "background_color", "label": "Section background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Section text color", "default": "#111111" },
    { "type": "color", "id": "card_bg", "label": "Card background", "default": "#ffffff" },
    { "type": "range", "id": "hover_zoom", "label": "Hover zoom", "min": 1, "max": 6, "step": 1, "default": 1 },
    { "type": "range", "id": "hover_saturate", "label": "Hover saturation", "min": 1, "max": 6, "step": 1, "default": 1 },
    {
      "type": "select",
      "id": "overlay_style",
      "label": "Text overlay style",
      "options": [
        { "value": "none", "label": "Below image" },
        { "value": "solid", "label": "Solid overlay" },
        { "value": "gradient", "label": "Gradient overlay" }
      ],
      "default": "gradient"
    },
    { "type": "color", "id": "overlay_bg", "label": "Overlay background", "default": "rgba(0,0,0,0.45)" },
    { "type": "color", "id": "overlay_text", "label": "Overlay text color", "default": "#ffffff" },
    { "type": "range", "id": "content_padding", "label": "Content padding (px)", "min": 0, "max": 32, "step": 2, "default": 12 },
    { "type": "color", "id": "content_bg", "label": "Content background (when below image)", "default": "transparent" },
    { "type": "color", "id": "badge_bg", "label": "Brand badge background", "default": "#111111" },
    { "type": "color", "id": "badge_text", "label": "Brand badge text", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Category" },
        { "type": "text", "id": "subtitle", "label": "Subtitle" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "text", "id": "badge_text", "label": "Badge text" },
        {
          "type": "select",
          "id": "badge_style",
          "label": "Badge style",
          "options": [
            { "value": "dark", "label": "Dark" },
            { "value": "light", "label": "Light" },
            { "value": "brand", "label": "Brand colors" }
          ],
          "default": "brand"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Featured categories",
      "category": "Image",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
