{% comment %}
  To use this code:
  Add {% section 'preloader' %} inside the <body> tag of theme.liquid
{% endcomment %}

<div class="preloader">
  <img src="{{ 'logo-only_load.gif' | asset_url }}" alt="Preloader">
</div>

<style>
  .preloader {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(255, 255, 255, 0.5); /* Semi-transparent white background */
    backdrop-filter: blur(10px); /* Applies the blur effect to the background */
    z-index: 9999;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .preloader img {
    width: 10%;
    height: auto; /* Ensure the image's aspect ratio is preserved */
  }

  /* Make the image smaller on smaller screens */
  @media (max-width: 768px) {
    .preloader img {
      width: 25%; /* Adjust width for medium-sized screens (e.g., tablets) */
      height: auto;
    }
  }

  /* Make the image even smaller on mobile screens */
  @media (max-width: 480px) {
    .preloader img {
      width: 30%; /* Adjust width for small screens (e.g., mobile phones) */
      height: auto;
    }
  }
</style>

<script>
  setTimeout(function() {
    var preloader = document.querySelector('.preloader');
    if (preloader) {
      preloader.remove(); // Remove the preloader from the DOM
    }
  }, 1501);
</script>
